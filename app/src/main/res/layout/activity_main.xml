<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Ana kart -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:layout_margin="24dp"
        android:background="@drawable/login_card_bg"
        android:elevation="8dp">

        <!-- SOL — Karakter paneli -->
        <com.kendi.tarayicim.CharacterView
            android:id="@+id/character_view"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#EEEAF4"
            android:clipToOutline="true"/>

        <!-- Dikey ayraç -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#E0E0E0"/>

        <!-- SAĞ — Form paneli -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#FFFFFF"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="28dp"
                android:paddingTop="36dp"
                android:paddingBottom="28dp">

                <!-- Logo -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✦"
                    android:textSize="22sp"
                    android:textColor="#111111"
                    android:layout_marginBottom="20dp"/>

                <!-- Başlık -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome back!"
                    android:textColor="#111111"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Please enter your details"
                    android:textColor="#999999"
                    android:textSize="11sp"
                    android:layout_marginBottom="28dp"/>

                <!-- Email label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    android:textColor="#444444"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp"/>

                <!-- Email input -->
                <EditText
                    android:id="@+id/input_email"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="@drawable/input_underline_bg"
                    android:inputType="textEmailAddress"
                    android:textColor="#111111"
                    android:textSize="13sp"
                    android:paddingStart="0dp"
                    android:paddingBottom="6dp"
                    android:singleLine="true"
                    android:layout_marginBottom="20dp"/>

                <!-- Password label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Password"
                    android:textColor="#444444"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp"/>

                <!-- Password input satırı -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/input_underline_bg"
                    android:layout_marginBottom="12dp">

                    <EditText
                        android:id="@+id/input_password"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:inputType="textPassword"
                        android:textColor="#111111"
                        android:textSize="13sp"
                        android:paddingStart="0dp"
                        android:paddingBottom="6dp"
                        android:singleLine="true"/>

                    <ImageButton
                        android:id="@+id/btn_toggle_password"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_eye_off"
                        android:background="@android:color/transparent"
                        android:contentDescription="Göster"/>
                </LinearLayout>

                <!-- Remember + Forgot -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="20dp">

                    <CheckBox
                        android:id="@+id/cb_remember"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Remember for 30 days"
                        android:textColor="#888888"
                        android:textSize="9sp"
                        android:buttonTint="#7C3AED"
                        android:layout_weight="1"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Forgot password?"
                        android:textColor="#888888"
                        android:textSize="9sp"/>
                </LinearLayout>

                <!-- Log in butonu -->
                <LinearLayout
                    android:id="@+id/btn_login"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:background="@drawable/btn_black_bg"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Log in"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- Google butonu -->
                <LinearLayout
                    android:id="@+id/btn_google"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:background="@drawable/btn_google_bg"
                    android:layout_marginBottom="24dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="G"
                        android:textColor="#4285F4"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Log in with Google"
                        android:textColor="#333333"
                        android:textSize="12sp"/>
                </LinearLayout>

                <!-- Hata -->
                <TextView
                    android:id="@+id/login_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#E53935"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp"/>

                <!-- Kayıt ol -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Don't have an account? "
                        android:textColor="#999999"
                        android:textSize="10sp"/>

                    <TextView
                        android:id="@+id/btn_register"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sign Up"
                        android:textColor="#7C3AED"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
