<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="32dp"
        android:paddingTop="60dp"
        android:paddingBottom="40dp">

        <!-- Karakter -->
        <com.kendi.tarayicim.CharacterView
            android:id="@+id/character_view"
            android:layout_width="160dp"
            android:layout_height="220dp"
            android:layout_marginBottom="32dp"/>

        <!-- Başlık -->
        <TextView
            android:id="@+id/login_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hoş Geldin"
            android:textColor="#F0F0F0"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/login_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hesabına giriş yap veya kayıt ol"
            android:textColor="#666666"
            android:textSize="13sp"
            android:layout_marginBottom="36dp"/>

        <!-- E-posta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/input_bg"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_section_general"
                android:layout_marginEnd="12dp"/>

            <EditText
                android:id="@+id/input_email"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="E-posta adresi"
                android:textColor="#F0F0F0"
                android:textColorHint="#444444"
                android:background="@android:color/transparent"
                android:inputType="textEmailAddress"
                android:textSize="14sp"
                android:singleLine="true"/>
        </LinearLayout>

        <!-- Şifre -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/input_bg"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="28dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_section_privacy"
                android:layout_marginEnd="12dp"/>

            <EditText
                android:id="@+id/input_password"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="Şifre"
                android:textColor="#F0F0F0"
                android:textColorHint="#444444"
                android:background="@android:color/transparent"
                android:inputType="textPassword"
                android:textSize="14sp"
                android:singleLine="true"/>

            <ImageButton
                android:id="@+id/btn_toggle_password"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_eye_off"
                android:background="@android:color/transparent"
                android:padding="4dp"
                android:contentDescription="Şifreyi göster"/>
        </LinearLayout>

        <!-- Giriş Yap butonu -->
        <LinearLayout
            android:id="@+id/btn_login"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:background="@drawable/btn_primary_bg"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Giriş Yap"
                android:textColor="#F0F0F0"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"/>
        </LinearLayout>

        <!-- Kayıt Ol butonu -->
        <LinearLayout
            android:id="@+id/btn_register"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:background="@drawable/btn_secondary_bg"
            android:layout_marginBottom="24dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kayıt Ol"
                android:textColor="#4D9EFF"
                android:textSize="15sp"
                android:letterSpacing="0.04"/>
        </LinearLayout>

        <!-- Hata mesajı -->
        <TextView
            android:id="@+id/login_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FF5252"
            android:textSize="13sp"
            android:gravity="center"
            android:visibility="gone"/>

    </LinearLayout>
</ScrollView>
